<% if (flash === 'saved') { %>
  <div class="flash success">Policy saved. auto_derived flipped to false.</div>
<% } %>
<% if (flash === 'resynced') { %>
  <div class="flash success">Re-derived from ConnectWise. auto_derived flipped to true; manual edits discarded.</div>
<% } %>
<% if (flash === 'resynced_default') { %>
  <div class="flash">Re-derived from ConnectWise, but no per-module permissions returned for this role. Default seed applied (ServiceTicket + Company + Reference). auto_derived flipped to true.</div>
<% } %>

<section class="card">
  <h1><%= role.role_name %></h1>
  <p class="muted">
    <% if (role.auto_derived) { %>
      <strong>Auto-derived</strong> — this policy was seeded by the last user import and will
      refresh on subsequent imports.
    <% } else { %>
      <strong>Manual</strong> — edits locked in. Subsequent user imports leave this row alone.
    <% } %>
    Last update <%= role.updated_at.toISOString() %><% if (role.updated_by) { %> by <%= role.updated_by %><% } %>.
  </p>

  <form method="post" action="/admin/permissions/<%= role.role_id %>/resync"
        onsubmit="return confirm('Re-derive this role\'s allow-list from ConnectWise security-role permissions? Any manual edits to this role will be overwritten.');"
        style="margin: 8px 0 0 0;">
    <button type="submit" class="button secondary">Re-derive from ConnectWise</button>
    <small class="muted" style="margin-left: 8px;">
      Refreshes this row from CW perms and flips auto_derived back to true.
    </small>
  </form>

  <% if (members.length > 0) { %>
    <p class="muted"><strong>Members with this role:</strong>
      <% for (let i = 0; i < members.length; i++) { %>
        <%= i > 0 ? ', ' : '' %><%= members[i].identifier %>
      <% } %>
    </p>
  <% } else { %>
    <p class="muted">No active members currently hold this role.</p>
  <% } %>

  <form method="post" action="/admin/permissions/<%= role.role_id %>">
    <% for (const g of groups) { %>
      <h2 style="margin-top: 24px;"><%= g.group %></h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 4px 16px;">
        <% for (const t of g.tools) { %>
          <label style="display: flex; align-items: center; gap: 6px;<% if (t.alwaysAdmin) { %> opacity: 0.5;<% } %>">
            <input type="checkbox"
              name="allowed_tools"
              value="<%= t.name %>"
              <% if (allowedSet.has(t.name) && !t.alwaysAdmin) { %>checked<% } %>
              <% if (t.alwaysAdmin) { %>disabled<% } %> />
            <code><%= t.name %></code>
            <% if (t.alwaysAdmin) { %>
              <small class="muted">(admin-only)</small>
            <% } %>
          </label>
        <% } %>
      </div>
    <% } %>

    <h2 style="margin-top: 32px;">Field projections</h2>
    <p class="muted">
      Hide individual response fields from this role per tool. One path per line. Grammar:
      <code>field</code>, <code>obj.field</code>, <code>arr[]</code>, <code>arr[].field</code>,
      nested arrays supported. Composites compute aggregates <em>before</em> redaction runs, so
      summary totals remain accurate even when the underlying fields are hidden. Admins and
      service accounts always see unredacted responses.
    </p>
    <p class="muted">
      Projections are saved alongside this role's allow-list. Granting a new tool? Save the
      checkboxes first, then return to this page to add projections for that tool.
    </p>

    <% const grantedTools = []; %>
    <% for (const g of groups) { %>
      <% for (const t of g.tools) { %>
        <% if (allowedSet.has(t.name) && !t.alwaysAdmin) grantedTools.push(t.name); %>
      <% } %>
    <% } %>

    <% if (grantedTools.length === 0) { %>
      <p class="muted">No tools granted to this role yet.</p>
    <% } else { %>
      <% for (const tool of grantedTools) { %>
        <% const existing = fieldProjections[tool] || []; %>
        <label style="margin-top: 12px;">
          <code><%= tool %></code>
          <textarea name="fieldproj-<%= tool %>" rows="3" placeholder="notes[].text&#10;internalAnalysisFlag" style="font-family: ui-monospace, monospace; font-size: 13px;"><%= existing.join('\n') %></textarea>
        </label>
      <% } %>
    <% } %>

    <p style="margin-top: 24px;">
      <input type="submit" value="Save policy" />
      <a class="button secondary" href="/admin/permissions">Cancel</a>
    </p>
  </form>
</section>
