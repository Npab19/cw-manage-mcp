<section class="card">
  <p class="muted"><a href="/admin/context">← All context</a></p>
  <h1>Per-user context</h1>
  <p class="muted">One document per imported member, keyed by their primary email. The user sees this layer in their merged <code>context://current</code>.</p>

  <form method="get" action="/admin/context/users" style="margin-bottom: 16px;">
    <input type="search" name="q" value="<%= q %>" placeholder="filter by identifier or email" style="min-width: 280px;" />
    <input type="submit" value="Filter" class="button secondary" />
    <% if (q) { %><a href="/admin/context/users" class="muted" style="margin-left: 8px;">clear</a><% } %>
  </form>

  <table>
    <thead>
      <tr><th>Identifier</th><th>Email</th><th>Document</th><th></th></tr>
    </thead>
    <tbody>
      <% for (const u of users) { %>
        <tr>
          <td><%= u.identifier %></td>
          <td><%= u.primary_email %></td>
          <td>
            <% if (u.has_doc) { %>
              v<%= u.version %> · <%= u.updated_at ? u.updated_at.toISOString().slice(0, 10) : '' %>
            <% } else { %>
              <span class="muted">none</span>
            <% } %>
          </td>
          <td><a class="button secondary" href="/admin/context/users/<%= encodeURIComponent(u.primary_email.toLowerCase()) %>">Edit</a></td>
        </tr>
      <% } %>
    </tbody>
  </table>
  <% if (users.length === 500) { %>
    <p class="muted">Showing first 500 — use the filter to narrow.</p>
  <% } %>
</section>
