<section class="card">
  <p class="muted"><a href="/admin/context">← All context</a></p>
  <h1>Preview merged context</h1>
  <p class="muted">
    Pick a user — we render exactly what their MCP client would receive when reading <code>context://current</code>
    (global + role layer for their role + user layer for them).
  </p>

  <form method="get" action="/admin/context/preview" style="margin-bottom: 16px;">
    <label for="email">Render as:</label>
    <select id="email" name="email" required style="min-width: 320px;">
      <option value="">— pick a user —</option>
      <% for (const u of userOptions) { %>
        <option value="<%= u.email %>" <% if (email === u.email) { %>selected<% } %>>
          <%= u.identifier %> · <%= u.email %><% if (u.security_role_name) { %> · <%= u.security_role_name %><% } %>
        </option>
      <% } %>
    </select>
    <input type="submit" value="Preview" />
  </form>
</section>

<% if (preview) { %>
  <section class="card">
    <h2>Composed context</h2>
    <% if (identity) { %>
      <p class="muted">
        As <strong><%= identity.oauthEmail %></strong>
        <% if (identity.cwMember && identity.cwMember.securityRoleName) { %>
          · role <strong><%= identity.cwMember.securityRoleName %></strong>
        <% } %>
      </p>
    <% } %>
    <pre style="white-space: pre-wrap; background: #f5f5f5; padding: 12px; border-radius: 4px; font-family: ui-monospace, monospace; font-size: 13px;"><%= preview %></pre>
  </section>
<% } %>
