<% if (flash === 'sync-ok' || (flash && flash.startsWith('sync-ok:'))) { %>
  <div class="flash success">User import complete<% if (flash.startsWith('sync-ok:')) { %> (<%= flash.slice('sync-ok:'.length) %>)<% } %>.</div>
<% } else if (flash === 'sync-error') { %>
  <div class="flash error">User import failed — see container logs.</div>
<% } else if (flash === 'map-ok') { %>
  <div class="flash success">Mapping saved.</div>
<% } else if (flash === 'unmap-ok') { %>
  <div class="flash success">Mapping removed.</div>
<% } else if (flash === 'map-missing' || flash === 'unmap-missing') { %>
  <div class="flash error">Missing required fields.</div>
<% } else if (flash === 'admin-promoted') { %>
  <div class="flash success">Admin role granted. The user's next sign-in reaches /admin.</div>
<% } else if (flash === 'admin-revoked') { %>
  <div class="flash success">Admin role revoked. The user's current session ends at their next request.</div>
<% } else if (flash === 'admin-self') { %>
  <div class="flash error">Can't revoke your own admin role through this UI. Use the DB or have another admin do it.</div>
<% } else if (flash === 'admin-missing') { %>
  <div class="flash error">Missing email.</div>
<% } %>

<section class="card">
  <h1>Users</h1>
  <p class="muted">
    <% if (lastRun) { %>
      Last sync <%= lastRun.startedAt.toISOString() %> by <%= lastRun.triggeredBy || 'unknown' %> —
      status <strong><%= lastRun.status %></strong>:
      <%= lastRun.rowsAdded %> added, <%= lastRun.rowsUpdated %> updated, <%= lastRun.rowsDeactivated %> deactivated.
    <% } else { %>
      No imports have run yet.
    <% } %>
  </p>
  <form method="post" action="/admin/users/sync" style="display: inline;">
    <input type="submit" value="Sync now" />
  </form>
</section>

<section class="card">
  <h2>Unmapped OAuth identities</h2>
  <% if (unmapped.length === 0) { %>
    <p class="muted">All seen identities are mapped to a CW member.</p>
  <% } else { %>
    <p class="muted">These users have signed in via OAuth but don't match any CW member's primary email. Link them manually to grant tool access.</p>
    <table>
      <thead><tr><th>Email</th><th>Subject (sub)</th><th>Last seen</th><th>Link to CW member</th></tr></thead>
      <tbody>
        <% for (const u of unmapped) { %>
          <tr>
            <td><%= u.email || '' %></td>
            <td class="muted" style="font-family: ui-monospace, monospace; font-size: 12px;"><%= u.sub %></td>
            <td><%= u.last_seen.toISOString() %></td>
            <td>
              <form method="post" action="/admin/users/map" style="display: flex; gap: 6px;">
                <input type="hidden" name="oauth_sub" value="<%= u.sub %>" />
                <select name="cw_member_id" required style="flex: 1;">
                  <option value="">— pick a member —</option>
                  <% for (const m of members) { %>
                    <% if (!m.inactive_flag && !m.mapped_oauth_sub) { %>
                      <option value="<%= m.id %>"><%= m.identifier %> — <%= m.first_name || '' %> <%= m.last_name || '' %> (<%= m.primary_email || 'no email' %>)</option>
                    <% } %>
                  <% } %>
                </select>
                <input type="submit" value="Link" />
              </form>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  <% } %>
</section>

<section class="card">
  <div style="display: flex; justify-content: space-between; align-items: center; gap: 16px;">
    <h2 style="margin: 0;">CW members</h2>
    <form method="get" action="/admin/users" style="margin: 0;">
      <label style="display: flex; align-items: center; gap: 6px; cursor: pointer;">
        <input type="checkbox" name="showApi" value="1" onchange="this.form.submit()" <%= showApi ? 'checked' : '' %> />
        Show API/integration accounts
      </label>
    </form>
  </div>
  <p class="muted">
    <%= members.length %> member(s) listed (capped at 5000).
    <% if (!showApi) { %> API/integration accounts hidden by default.<% } %>
  </p>
  <table>
    <thead>
      <tr>
        <th>Identifier</th>
        <th>Name</th>
        <th>Email</th>
        <th>Role</th>
        <th>Type</th>
        <th>Mapping</th>
        <th>Admin</th>
        <th>Status</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% for (const m of members) { %>
        <% const memberEmail = (m.primary_email || '').toLowerCase(); %>
        <% const isEnvAdmin = memberEmail && envAdminEmails.includes(memberEmail); %>
        <% const isDbAdmin = memberEmail && dbAdminEmails.has(memberEmail); %>
        <tr<% if (m.inactive_flag) { %> class="muted"<% } %>>
          <td><code><%= m.identifier %></code></td>
          <td><%= m.first_name || '' %> <%= m.last_name || '' %></td>
          <td><%= m.primary_email || '' %></td>
          <td><%= m.security_role_name || '' %></td>
          <td><%= m.member_type || '' %></td>
          <td>
            <% if (m.mapped_oauth_email) { %>
              <%= m.mapped_oauth_email %>
              <small class="muted">(<%= m.mapping_source %>)</small>
            <% } else { %>
              <span class="muted">—</span>
            <% } %>
          </td>
          <td>
            <% if (isEnvAdmin) { %>
              <span style="color: var(--accent);">env</span>
            <% } else if (isDbAdmin) { %>
              <span style="color: var(--accent);">DB</span>
            <% } else { %>
              <span class="muted">—</span>
            <% } %>
          </td>
          <td><%= m.inactive_flag ? 'inactive' : 'active' %></td>
          <td style="display: flex; gap: 4px; flex-wrap: wrap;">
            <% if (m.mapped_oauth_sub) { %>
              <form method="post" action="/admin/users/unmap" style="display: inline;">
                <input type="hidden" name="oauth_sub" value="<%= m.mapped_oauth_sub %>" />
                <button type="submit" class="button secondary">Unmap</button>
              </form>
            <% } %>
            <% if (memberEmail && !isEnvAdmin && !m.inactive_flag) { %>
              <% if (isDbAdmin) { %>
                <form method="post" action="/admin/users/revoke-admin" style="display: inline;"
                  onsubmit="return confirm('Revoke admin role from <%= memberEmail %>?');">
                  <input type="hidden" name="email" value="<%= memberEmail %>" />
                  <button type="submit" class="button secondary">Revoke admin</button>
                </form>
              <% } else { %>
                <form method="post" action="/admin/users/promote-admin" style="display: inline;"
                  onsubmit="return confirm('Grant admin role to <%= memberEmail %>?');">
                  <input type="hidden" name="email" value="<%= memberEmail %>" />
                  <button type="submit" class="button secondary">Promote</button>
                </form>
              <% } %>
            <% } %>
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
</section>

<section class="card">
  <h2>Admin role assignments</h2>
  <p class="muted">
    DB-backed admin grants (additive to the <code>ADMIN_EMAILS</code> env allow-list, which always
    wins as a break-glass path). Revoked rows are retained for the audit trail.
  </p>
  <% if (adminAssignments.length === 0) { %>
    <p class="muted">No DB-managed admin assignments yet.</p>
  <% } else { %>
    <table>
      <thead><tr><th>Email</th><th>Granted</th><th>Revoked</th></tr></thead>
      <tbody>
        <% for (const a of adminAssignments) { %>
          <tr<% if (a.revoked_at) { %> class="muted"<% } %>>
            <td><%= a.email %></td>
            <td><%= a.granted_at.toISOString() %> by <%= a.granted_by %></td>
            <td>
              <% if (a.revoked_at) { %>
                <%= a.revoked_at.toISOString() %><% if (a.revoked_by) { %> by <%= a.revoked_by %><% } %>
              <% } else { %>
                <span class="muted">active</span>
              <% } %>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  <% } %>
</section>
