<% if (flash === 'revoked') { %>
  <div class="flash success">Service account revoked. Subsequent requests with that key will return 401.</div>
<% } else if (flash === 'missing-name') { %>
  <div class="flash error">Name is required.</div>
<% } else if (flash === 'no-tools') { %>
  <div class="flash error">Pick at least one tool for the allow-list.</div>
<% } else if (flash === 'duplicate-name') { %>
  <div class="flash error">A service account with that name already exists.</div>
<% } %>

<section class="card">
  <h1>Service accounts</h1>
  <p class="muted">
    Long-lived API keys that bypass OAuth. Use for CI runners, n8n flows, or any integration that
    can't run a browser-based sign-in. Each key is scoped to an explicit tool allow-list; admin-only
    tools are never grantable. Keys are hashed with argon2id — once shown, they're gone.
  </p>

  <% if (accounts.length === 0) { %>
    <p class="muted">No service accounts yet.</p>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Description</th>
          <th>Key prefix</th>
          <th>Allowed tools</th>
          <th>Created</th>
          <th>Last used</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% for (const a of accounts) { %>
          <tr<% if (a.revoked_at) { %> class="muted"<% } %>>
            <td><strong><%= a.name %></strong></td>
            <td><%= a.description || '' %></td>
            <td><code>sa_<%= a.key_prefix %>_…</code></td>
            <td><%= a.allowed_tools.length %> tool(s)</td>
            <td><%= a.created_at.toISOString() %> by <%= a.created_by %></td>
            <td><%= a.last_used_at ? a.last_used_at.toISOString() : '—' %></td>
            <td><%= a.revoked_at ? 'revoked ' + a.revoked_at.toISOString() : 'active' %></td>
            <td>
              <% if (!a.revoked_at) { %>
                <form method="post" action="/admin/service-accounts/<%= a.id %>/revoke" style="display: inline;"
                  onsubmit="return confirm('Revoke <%= a.name %>? Subsequent requests with its key will return 401.');">
                  <button type="submit" class="button secondary">Revoke</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  <% } %>

  <h2 style="margin-top: 24px;">Create service account</h2>
  <form method="post" action="/admin/service-accounts">
    <label>Name
      <input type="text" name="name" required placeholder="n8n-prod" pattern="[A-Za-z0-9_\-]+" />
    </label>
    <label>Description
      <input type="text" name="description" placeholder="Optional — what is this key used for?" />
    </label>

    <h3 style="margin-top: 16px;">Allowed tools</h3>
    <p class="muted">Admin-only tools (<code>get_audit_trail</code>, <code>get_system_info</code>) are never grantable to a service account.</p>
    <% for (const g of groups) { %>
      <h4 style="margin-top: 16px; font-size: 13px; text-transform: uppercase; color: var(--muted);"><%= g.group %></h4>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 4px 16px;">
        <% for (const t of g.tools) { %>
          <% if (!t.alwaysAdmin) { %>
            <label style="display: flex; align-items: center; gap: 6px;">
              <input type="checkbox" name="allowed_tools" value="<%= t.name %>" />
              <code><%= t.name %></code>
            </label>
          <% } %>
        <% } %>
      </div>
    <% } %>

    <p style="margin-top: 24px;">
      <input type="submit" value="Create service account" />
    </p>
  </form>
</section>
