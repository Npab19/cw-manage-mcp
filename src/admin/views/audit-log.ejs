<section class="card">
  <h1>MCP audit log</h1>
  <p class="muted">One row per <code>/mcp</code> tool call. Best-effort capture — failures to record never block the response.</p>

  <form method="get" action="/admin/audit-log" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px;">
    <label>From
      <input type="text" name="from" value="<%= filters.from || '' %>" placeholder="YYYY-MM-DD or ISO" />
    </label>
    <label>To
      <input type="text" name="to" value="<%= filters.to || '' %>" placeholder="YYYY-MM-DD or ISO" />
    </label>
    <label>Email contains
      <input type="text" name="email" value="<%= filters.email || '' %>" />
    </label>
    <label>Tool
      <select name="tool">
        <option value="">— any —</option>
        <% for (const t of tools) { %>
          <option value="<%= t %>" <%= filters.tool === t ? 'selected' : '' %>><%= t %></option>
        <% } %>
      </select>
    </label>
    <label>Status
      <select name="status">
        <option value="">— any —</option>
        <option value="success" <%= filters.status === 'success' ? 'selected' : '' %>>success</option>
        <option value="error" <%= filters.status === 'error' ? 'selected' : '' %>>error</option>
      </select>
    </label>
    <label>Args contain
      <input type="text" name="argsSearch" value="<%= filters.argsSearch || '' %>" placeholder="substring" />
    </label>
    <div style="display: flex; align-items: end; gap: 8px;">
      <input type="submit" value="Filter" />
      <a class="button secondary" href="/admin/audit-log">Reset</a>
      <a class="button secondary" href="/admin/audit-log.csv?<%= filterQs %>">CSV</a>
    </div>
  </form>

  <p class="muted" style="margin-top: 16px; display: flex; align-items: center; justify-content: space-between; gap: 16px;">
    <span>
      <%= total.toLocaleString() %> total row(s) match.
      Showing latest <%= rows.length %><% if (isCursorPage) { %> (older than cursor)<% } %>.
    </span>
    <label style="display: flex; gap: 6px; align-items: center;">
      <input type="checkbox" id="live-updates" checked />
      Live updates (5s)
    </label>
  </p>

  <div style="overflow-x: auto;">
    <table>
      <thead>
        <tr>
          <th>Timestamp</th>
          <th>Email</th>
          <th>Tool</th>
          <th>Status</th>
          <th>Duration</th>
          <th>Request ID</th>
        </tr>
      </thead>
      <tbody
        id="audit-rows"
        hx-get="/admin/audit-log/rows?<%= filterQs %>"
        hx-trigger="every 5s"
        hx-swap="afterbegin"
        hx-vals='js:{since: document.querySelector("#audit-rows tr")?.dataset.ts || ""}'>
        <% if (rows.length === 0) { %>
          <tr><td colspan="6" class="muted">No matching rows.</td></tr>
        <% } else { %>
          <%- include('_audit-log-rows', { rows }) %>
        <% } %>
      </tbody>
    </table>
  </div>

  <% if (oldestTs && rows.length >= pageSize) { %>
    <p style="margin-top: 16px;">
      <button class="button secondary"
        hx-get="/admin/audit-log/rows?<%= filterQs %>&before=<%= encodeURIComponent(oldestTs) %>"
        hx-target="#audit-rows"
        hx-swap="beforeend"
        hx-on::after-request="this.setAttribute('hx-get', '/admin/audit-log/rows?<%= filterQs %>&before=' + encodeURIComponent(document.querySelector('#audit-rows tr:last-child')?.dataset.ts || ''))">
        Load older (next <%= pageSize %>)
      </button>
    </p>
  <% } %>
</section>

<script>
  (function() {
    var checkbox = document.getElementById('live-updates');
    var tbody = document.getElementById('audit-rows');
    if (!checkbox || !tbody) return;

    var stored = localStorage.getItem('auditLogLive');
    if (stored === 'off') {
      checkbox.checked = false;
      tbody.removeAttribute('hx-trigger');
    }
    if (window.htmx) window.htmx.process(tbody);

    checkbox.addEventListener('change', function() {
      if (checkbox.checked) {
        tbody.setAttribute('hx-trigger', 'every 5s');
        localStorage.setItem('auditLogLive', 'on');
      } else {
        tbody.removeAttribute('hx-trigger');
        localStorage.setItem('auditLogLive', 'off');
      }
      if (window.htmx) window.htmx.process(tbody);
    });
  })();
</script>
