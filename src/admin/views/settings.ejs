<% if (flash === 'cw-saved') { %>
  <div class="flash success">CW connection updated.</div>
<% } else if (flash === 'oauth-saved') { %>
  <div class="flash success">OAuth provider updated.</div>
<% } else if (flash === 'operational-saved') { %>
  <div class="flash success">Operational settings saved.</div>
<% } else if (flash && flash.startsWith('cache-cleared:')) { %>
  <div class="flash success">Cache cleared (<%= flash.slice('cache-cleared:'.length) %> entries dropped).</div>
<% } else if (flash === 'rate-buckets-cleared') { %>
  <div class="flash success">Rate-limit buckets reset. Existing users get a fresh capacity on their next call.</div>
<% } else if (flash && flash.startsWith('missing:')) { %>
  <div class="flash error">Missing required fields: <%= flash.slice('missing:'.length) %></div>
<% } %>

<section class="card">
  <h1>OAuth provider</h1>
  <% if (oauth) { %>
    <p class="muted">Current configuration. Leave the client secret blank to keep the existing value.</p>
  <% } else { %>
    <p class="muted">Not configured yet — fill all fields below.</p>
  <% } %>
  <form method="post" action="/admin/settings/oauth-provider">
    <label>IdP issuer URL
      <input type="url" name="oauthIssuer" required value="<%= oauth ? oauth.issuer : '' %>" />
    </label>
    <label>OAuth client ID
      <input type="text" name="oauthClientId" required value="<%= oauth ? oauth.clientId : '' %>" />
    </label>
    <label>OAuth client secret
      <input type="password" name="oauthClientSecret" placeholder="<%= oauth ? maskSecret(oauth.clientSecret) + ' (leave blank to keep)' : '' %>" />
    </label>
    <label>Allowed email domains (comma-separated)
      <input type="text" name="allowedEmailDomains" required value="<%= oauth ? oauth.allowedEmailDomains.join(', ') : '' %>" />
    </label>
    <label>Public base URL of this server
      <input type="url" name="publicBaseUrl" required value="<%= oauth ? oauth.publicBaseUrl : '' %>" />
    </label>
    <p style="margin-top: 16px;">
      <input type="submit" value="Save OAuth provider" />
    </p>
  </form>
</section>

<section class="card">
  <h1>ConnectWise connection</h1>
  <% if (cw) { %>
    <p class="muted">Current configuration. Leave the private key blank to keep the existing value.</p>
  <% } else { %>
    <p class="muted">Not configured yet — fill all fields below.</p>
  <% } %>
  <form method="post" action="/admin/settings/cw-connection">
    <label>CW base URL
      <select onchange="document.getElementsByName('cwBaseUrl')[0].value = this.value === 'custom' ? document.getElementsByName('cwBaseUrl')[0].value : this.value;">
        <option value="">— pick a region —</option>
        <% for (const [key, url] of Object.entries(regionOptions)) { %>
          <option value="<%= url %>" <%= cw && cw.baseUrl === url ? 'selected' : '' %>><%= key.toUpperCase() %> (<%= url %>)</option>
        <% } %>
        <option value="custom">Custom (on-premise)</option>
      </select>
    </label>
    <input type="url" name="cwBaseUrl" required value="<%= cw ? cw.baseUrl : '' %>" />

    <label>CW codebase
      <select name="cwCodebase" required>
        <% for (const cb of codebaseOptions) { %>
          <option value="<%= cb %>" <%= (cw && cw.codebase === cb) ? 'selected' : '' %>><%= cb %></option>
        <% } %>
      </select>
    </label>
    <label>CW client ID
      <input type="text" name="cwClientId" required value="<%= cw ? cw.clientId : '' %>" />
    </label>
    <label>CW company ID
      <input type="text" name="cwCompanyId" required value="<%= cw ? cw.companyId : '' %>" />
    </label>
    <label>CW public key
      <input type="text" name="cwPublicKey" required value="<%= cw ? cw.publicKey : '' %>" />
    </label>
    <label>CW private key
      <input type="password" name="cwPrivateKey" placeholder="<%= cw ? maskSecret(cw.privateKey) + ' (leave blank to keep)' : '' %>" />
    </label>

    <p style="margin-top: 16px;">
      <button type="button" class="button secondary"
        hx-post="/admin/settings/cw-connection/test"
        hx-include="[name='cwBaseUrl'],[name='cwCodebase'],[name='cwClientId'],[name='cwCompanyId'],[name='cwPublicKey'],[name='cwPrivateKey']"
        hx-target="#cw-test-result"
        hx-swap="innerHTML">
        Test connection
      </button>
      <span id="cw-test-result" class="muted" style="margin-left: 12px;"></span>
    </p>

    <p style="margin-top: 16px;">
      <input type="submit" value="Save CW connection" />
    </p>
  </form>
</section>

<section class="card">
  <h1>Operational</h1>
  <p class="muted">
    Cache TTL, rate limits, sync schedule, retention windows, backup behavior. Changes take effect
    on the next request — no restart required. Defaults are shown as placeholders.
  </p>

  <form method="post" action="/admin/settings/operational">
    <h2 style="margin-top: 8px;">Cache</h2>
    <p class="muted">
      Cache holds <strong><%= cacheStats.size %></strong> entr(ies).
      Hit rate this process:
      <strong><%= cacheStats.hitRate != null ? (cacheStats.hitRate * 100).toFixed(1) + '%' : '—' %></strong>
      (<%= cacheStats.hits %> hits / <%= cacheStats.misses %> misses).
    </p>
    <label>Lookup TTL (seconds)
      <input type="number" name="cacheLookupTtlSeconds" min="1" value="<%= operational.cacheLookupTtlSeconds %>" />
    </label>

    <h2 style="margin-top: 20px;">Rate limits</h2>
    <p class="muted">Token-bucket per identity. Capacity = burst size; refill = sustained per minute. Defaults: 60 / 60 for humans, 600 / 600 for service accounts.</p>
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
      <label>Per-user capacity
        <input type="number" name="rateUserCapacity" min="1" value="<%= operational.rateUserCapacity %>" />
      </label>
      <label>Per-user refill / minute
        <input type="number" name="rateUserRefillPerMinute" min="1" value="<%= operational.rateUserRefillPerMinute %>" />
      </label>
      <label>Per-service-account capacity
        <input type="number" name="rateSaCapacity" min="1" value="<%= operational.rateSaCapacity %>" />
      </label>
      <label>Per-service-account refill / minute
        <input type="number" name="rateSaRefillPerMinute" min="1" value="<%= operational.rateSaRefillPerMinute %>" />
      </label>
    </div>

    <h2 style="margin-top: 20px;">Sync schedules</h2>
    <label>User import cron
      <input type="text" name="userImportCron" value="<%= operational.userImportCron %>" placeholder="0 2 * * *" />
    </label>
    <p class="muted" style="font-size: 12px;">Standard 5-field cron. Default <code>0 2 * * *</code> (2 AM nightly). Restart required for the cron schedule to take effect.</p>

    <h2 style="margin-top: 20px;">Retention</h2>
    <label>MCP audit log retention (days)
      <input type="number" name="auditLogRetentionDays" min="1" value="<%= operational.auditLogRetentionDays %>" />
    </label>
    <p class="muted" style="font-size: 12px;">Rows older than this are pruned nightly.</p>

    <h2 style="margin-top: 20px;">Backups</h2>
    <label style="display: flex; align-items: center; gap: 6px;">
      <input type="checkbox" name="backupEnabled" <%= operational.backupEnabled ? 'checked' : '' %> />
      Enable nightly Postgres dump
    </label>
    <label>Backup path (inside the container)
      <input type="text" name="backupPath" value="<%= operational.backupPath %>" placeholder="/backups" />
    </label>
    <label>Backup retention (days)
      <input type="number" name="backupRetentionDays" min="1" value="<%= operational.backupRetentionDays %>" />
    </label>

    <p style="margin-top: 24px; display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
      <input type="submit" value="Save operational settings" />
    </p>
  </form>

  <form method="post" action="/admin/settings/cache/clear" style="display: inline; margin-top: 8px;"
    onsubmit="return confirm('Drop every cached lookup? Next callers refetch.');">
    <button type="submit" class="button secondary">Clear cache now</button>
  </form>
  <form method="post" action="/admin/settings/rate-buckets/reset" style="display: inline; margin-left: 8px;"
    onsubmit="return confirm('Reset all rate-limit buckets? Everyone gets fresh capacity.');">
    <button type="submit" class="button secondary">Reset rate-limit buckets</button>
  </form>
</section>
