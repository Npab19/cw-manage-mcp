<section class="card">
  <h1>Service account created</h1>
  <p><strong><%= account.name %></strong> is active. Copy the key below — it's the only time it will be shown.</p>

  <div class="flash error" style="font-size: 13px;">
    <strong>Store this key in a secrets manager now.</strong>
    The server only kept an argon2id hash; if you lose this string, the only path forward is to revoke this account and create a new one.
  </div>

  <label>Full API key
    <textarea readonly rows="2" style="font-family: ui-monospace, SFMono-Regular, monospace; font-size: 13px;" onclick="this.select()"><%= fullKey %></textarea>
  </label>

  <p class="muted" style="margin-top: 12px;">
    Use it as a bearer token against <code>/mcp</code>:
  </p>
  <pre>Authorization: Bearer <%= fullKey %></pre>

  <p style="margin-top: 24px;">
    <a class="button" href="/admin/service-accounts">Done</a>
  </p>
</section>
