# ConnectWise Manage MCP Server — Environment Variables
# Copy this file to .env and fill in your values

# A unique GUID that identifies your integration to ConnectWise.
# Generate one at https://developer.connectwise.com/ClientID
CW_CLIENT_ID=your-unique-guid-here

# The base URL for your ConnectWise Manage instance.
# Cloud (North America): https://api-na.myconnectwise.net
# Cloud (Europe):        https://api-eu.myconnectwise.net
# Cloud (Australia):     https://api-au.myconnectwise.net
# Staging/Dev:           https://api-staging.connectwisedev.com
# On-Premise:            https://your-domain.com (no trailing slash)
CW_BASE_URL=https://api-na.myconnectwise.net

# The ConnectWise API codebase version segment used in the URL path.
# Default: v2025_1 (current). Older codebases: v4_6_release, v2023_1, v2022_1, v2021_2.
CW_CODEBASE=v2025_1

# Port for the MCP HTTP server (default: 3000)
PORT=3000

# === OAuth (optional in Phase 1) ===
# When OAUTH_ISSUER is set, this server acts as a full OAuth 2.1 Authorization
# Server to MCP clients (e.g. Claude.ai), and delegates the actual login to the
# IdP configured below. /mcp then requires a valid Bearer JWT minted by THIS
# server (not the IdP). When OAUTH_ISSUER is unset, the server falls back to
# URL-param credentials (legacy mode). All OAUTH_* + PUBLIC_BASE_URL vars are
# required together.

# IdP issuer URL. Examples:
#   Entra ID (Microsoft):  https://login.microsoftonline.com/<tenant-id>/v2.0
#   Google Workspace:      https://accounts.google.com
# OAUTH_ISSUER=

# Entra App Registration "Application (client) ID" — used by THIS server to
# authenticate to Entra. The App Registration must have a redirect URI of
# `${PUBLIC_BASE_URL}/oauth/callback` and a client secret configured.
# OAUTH_CLIENT_ID=

# Entra App Registration client secret value.
# OAUTH_CLIENT_SECRET=

# Comma-separated email domains allowed to use the MCP. The signed-in user's
# `email` claim must end with one of these domains. Case-insensitive.
# Example: OAUTH_ALLOWED_EMAIL_DOMAINS=wheelhouseit.com
# OAUTH_ALLOWED_EMAIL_DOMAINS=

# Public URL of this MCP server (no trailing slash). Used as the JWT issuer
# and audience, and as the basis for OAuth callback URLs.
# Example: PUBLIC_BASE_URL=https://cwmcp.example.com
# PUBLIC_BASE_URL=

# Where to persist the RS256 signing keypair. The Docker compose stack mounts
# a named volume at /data — leave as default unless running outside Docker.
# OAUTH_KEY_FILE=/data/oauth-keys.json

# === Server-side ConnectWise credentials (required when OAuth is enabled) ===
# In OAuth mode, CW credentials live on the server instead of being passed in
# the /mcp URL. All three must be set when OAUTH_ISSUER is set.
# CW_COMPANY_ID=your-cw-company-id
# CW_PUBLIC_KEY=your-cw-public-key
# CW_PRIVATE_KEY=your-cw-private-key

# Cloudflare Tunnel token (from https://one.dash.cloudflare.com -> Networks -> Tunnels)
# Create a tunnel, set the public hostname to point to http://cw-manage-mcp:3000
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here
