# ConnectWise Manage MCP Server — Environment Variables
# Copy this file to .env and fill in your values

# A unique GUID that identifies your integration to ConnectWise.
# Generate one at https://developer.connectwise.com/ClientID
CW_CLIENT_ID=your-unique-guid-here

# The base URL for your ConnectWise Manage instance.
# Cloud (North America): https://api-na.myconnectwise.net
# Cloud (Europe):        https://api-eu.myconnectwise.net
# Cloud (Australia):     https://api-au.myconnectwise.net
# Staging/Dev:           https://api-staging.connectwisedev.com
# On-Premise:            https://your-domain.com (no trailing slash)
CW_BASE_URL=https://api-na.myconnectwise.net

# The ConnectWise API codebase version segment used in the URL path.
# Examples: v2021_2, v2022_1, v2023_1
CW_CODEBASE=v4_6_release

# Port for the MCP HTTP server (default: 3000)
PORT=3000

# === OAuth resource server (optional in Phase 1) ===
# When OAUTH_ISSUER is set, /mcp requires a valid Bearer JWT signed by the
# configured IdP, with an email claim in OAUTH_ALLOWED_EMAIL_DOMAINS. When
# unset, the server falls back to URL-param credentials (legacy mode).
# All three vars below are required when OAuth is enabled.

# IdP issuer URL. Examples:
#   Entra ID (Microsoft):  https://login.microsoftonline.com/<tenant-id>/v2.0
#   Google Workspace:      https://accounts.google.com
# OAUTH_ISSUER=

# Expected `aud` claim — this server's identifier as registered in the IdP
# app/API configuration (e.g. the Application ID URI in Entra).
# OAUTH_AUDIENCE=

# Comma-separated email domains allowed to use the MCP. The bearer token's
# `email` claim must end with one of these domains. Case-insensitive.
# Example: OAUTH_ALLOWED_EMAIL_DOMAINS=wheelhouseit.com
# OAUTH_ALLOWED_EMAIL_DOMAINS=

# Cloudflare Tunnel token (from https://one.dash.cloudflare.com -> Networks -> Tunnels)
# Create a tunnel, set the public hostname to point to http://cw-manage-mcp:3000
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here
