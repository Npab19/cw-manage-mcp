# ConnectWise Manage MCP Server — Environment Configuration
# Copy this file to .env and fill in the REQUIRED values below.
#
# docker compose loads everything in .env into the cw-manage-mcp container
# automatically (via env_file: .env). The setup wizard at /admin/setup
# collects OAuth and CW credentials at first run; any of those values you
# set here are used to pre-fill the wizard form. Once setup completes,
# the dashboard's Settings page is the source of truth — env vars become
# fallback only.

# ============================================================
# REQUIRED — set these before first `docker compose up`
# ============================================================

# Postgres password. Used by the Postgres sidecar at startup. The MCP
# container reads it via env_file to assemble DATABASE_URL.
# Rotate by:  docker compose down  →  edit .env  →  docker compose up -d
POSTGRES_PASSWORD=change-me

# Token for the Cloudflare Tunnel sidecar. Create a tunnel at
# https://one.dash.cloudflare.com → Networks → Tunnels.
# Point the tunnel's public hostname at http://cw-manage-mcp:3000
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here

# Public URL of this server (no trailing slash). Used as the JWT issuer/
# audience and the basis for the OAuth callback URL. Must match the
# Cloudflare Tunnel hostname. Needed before the wizard runs so the
# bootstrap URL banner can print the right address.
PUBLIC_BASE_URL=https://cwmcp.example.com

# Permanent admin allow-list (break-glass). Comma-separated, case-insensitive.
# Emails here always have admin access regardless of what's in the DB.
# The setup wizard's "first admin" gets added to a DB-managed list that
# layers on top of this — but this env list is your recovery path if the
# DB row is lost.
ADMIN_EMAILS=you@yourcompany.com

# ============================================================
# OPTIONAL — image pinning / rollback
# ============================================================
# Which cw-manage-mcp image tag docker compose runs. Unset = latest.
# Every push to master publishes immutable tags alongside `latest`:
#   sha-<short-commit>   e.g. sha-a1b2c3d   (ties to a specific commit)
#   build-<run-number>   e.g. build-42      (monotonic, easy to step back)
# Browse published tags:
#   https://github.com/npab19/cw-manage-mcp/pkgs/container/cw-manage-mcp
# To roll back: set the tag here, then `docker compose up -d`.
# APP_IMAGE_TAG=latest

# ============================================================
# OPTIONAL — wizard pre-fills
# ============================================================
# Set these to pre-fill the corresponding fields in the setup wizard.
# Leave commented to have the wizard collect them at first run.
# After setup, the dashboard's Settings page is the source of truth;
# these env vars are only fallback for missing DB rows.

# --- ConnectWise Manage connection ---
# Generate the keypair under System → Members → <API Member> → API Keys.
# Cloud base URLs by region:
#   North America:    https://api-na.myconnectwise.net
#   Europe:           https://api-eu.myconnectwise.net
#   Australia:        https://api-au.myconnectwise.net
#   Staging/Dev:      https://api-staging.connectwisedev.com
#   On-Premise:       https://your-domain.com  (no trailing slash)
# Codebase: current = v2025_1; older = v4_6_release, v2021_2, v2022_1, v2023_1

# CW_CLIENT_ID=your-unique-guid-here
# CW_BASE_URL=https://api-na.myconnectwise.net
# CW_CODEBASE=v2025_1
# CW_COMPANY_ID=your-cw-company-id
# CW_PUBLIC_KEY=your-cw-public-key
# CW_PRIVATE_KEY=your-cw-private-key

# --- OAuth IdP ---
# IdP issuer URL (no trailing slash). Examples:
#   Entra ID:          https://login.microsoftonline.com/<tenant-id>/v2.0
#   Google Workspace:  https://accounts.google.com

# OAUTH_ISSUER=https://login.microsoftonline.com/your-tenant-id/v2.0
# OAUTH_CLIENT_ID=your-app-client-id
# OAUTH_CLIENT_SECRET=your-client-secret
# OAUTH_ALLOWED_EMAIL_DOMAINS=yourcompany.com

# ============================================================
# Advanced — rarely changed
# ============================================================

# HTTP port the MCP server listens on. Default: 3000.
# If you change this, also update Dockerfile EXPOSE + the healthcheck URL.
# PORT=3000

# Override the Postgres connection string. Compose assembles this from
# POSTGRES_PASSWORD by default; only set this when running outside compose.
# DATABASE_URL=postgres://cw_mcp:change-me@localhost:5432/cw_mcp_dashboard

# Path inside the container where the RS256 keypair is persisted. The
# compose stack mounts a volume at /data so the default works as-is.
# Change only if running outside docker-compose.
# OAUTH_KEY_FILE=/data/oauth-keys.json
